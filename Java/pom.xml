                </configuration>
            </plugin>
            -->
            <!--
              Pinned because the version inherited from the super-POM is 2.12.4,
              which dates from 2012 and reports a skipped test as a bare
              <skipped/> with no message. CancelOnNotImplemented reports an
              unwritten exercise as skipped, carrying the location of the work
              ("You need to implement the code at Bag_Array.java:187"), and that
              message is the useful part. Surefire 3.x records it.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
    <properties>
        <!-- NOTE: "21", not "1.21". javac only accepts the 1.x form up to 1.10;
             anything later must be bare. With the compiler plugin commented out
             above, these properties are what reach javac, so "1.21" fails the
             build outright with "invalid target release: 1.21". -->
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>
    <repositories>
